// Skema e bazës së të dhënave — IntexFin
// Moduli: Shpenzime

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rolet e përdoruesve në sistem
enum Role {
  ADMIN // Akses i plotë, menaxhon përdoruesit dhe konfigurimet
  FINANCE // Aprovon, regjistron pagesa, sheh të gjitha shpenzimet
  STAFF // Krijon dhe dërgon për aprovim shpenzimet e veta
}

/// Statuset e një shpenzimi
enum ExpenseStatus {
  DRAFT // Draft — ende i pa dërguar
  SUBMITTED // Dërguar për aprovim
  APPROVED // Aprovuar nga financa
  REJECTED // Refuzuar
  PAID // Paguar
}

/// Mënyrat e pagesës
enum PaymentMethod {
  CASH // Para në dorë / arkë
  BANK // Transfertë bankare
  CARD // Kartë
  OTHER // Tjetër
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expensesCreated  Expense[]   @relation("ExpenseCreatedBy")
  expensesApproved Expense[]   @relation("ExpenseApprovedBy")
  auditLogs        AuditLog[]

  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@index([active])
  @@map("categories")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  nipt      String?  @unique // NIPT / NUIS i furnitorit
  email     String?
  phone     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([active])
  @@map("suppliers")
}

model Expense {
  id             String        @id @default(cuid())
  reference      String        @unique // p.sh. SHP-2026-0001
  expenseDate    DateTime // Data e shpenzimit
  documentNumber String? // Nr. i faturës / dokumentit
  description    String
  amount         Decimal       @db.Decimal(12, 2) // Vlera pa TVSH
  vatRate        Decimal       @default(0) @db.Decimal(5, 2) // % e TVSH-së
  vatAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2) // amount + vatAmount
  currency       String        @default("ALL")
  paymentMethod  PaymentMethod @default(BANK)
  status         ExpenseStatus @default(DRAFT)
  notes          String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  paidAt       DateTime?

  attachments Attachment[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([supplierId])
  @@index([createdById])
  @@map("expenses")
}

model Attachment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName     String // Emri i ruajtur në disk
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@map("attachments")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // p.sh. EXPENSE_CREATED, EXPENSE_APPROVED
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([userId])
  @@map("audit_logs")
}
